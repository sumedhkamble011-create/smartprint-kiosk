# Environment Configuration Template for SmartPrintKiosk
# Copy this file to .env and customize the values for your local environment

# Security Key (Generate a secure key for production)
DJANGO_SECRET_KEY=django-insecure-smartprint-kiosk-college-demo-key-2026-change-in-prod

# Debug Mode: True for local development, False for production
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of hostnames or IP addresses)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration:
# Choose 'postgresql' for PostgreSQL (production/target) or 'sqlite' for initial local development
DB_ENGINE=sqlite
DB_NAME=smartprint_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Printing Mode: 'simulation' (default, safe for demo) or 'worker' (physical print worker)
PRINT_MODE=simulation

# Maximum Upload File Size in Megabytes (default: 15 MB)
MAX_UPLOAD_SIZE_MB=15

# Default Pricing Configuration (in INR - ₹)
DEFAULT_BW_RATE=2.00
DEFAULT_COLOR_RATE=10.00
DEFAULT_DUPLEX_DISCOUNT=0.00
